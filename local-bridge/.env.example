# URL of the deployed (or local) cloud server
CLOUD_SERVER_URL=http://localhost:5000

# A stable name for this bridge instance, shown in server logs
BRIDGE_NAME=HP-EliteBook-Bridge

# Google Drive (used later by src/storage/googleDriveUploader.js)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=
