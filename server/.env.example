PORT=5000

# Comma-separated list of allowed frontend origins (Vite dev + deployed Vercel URL)
CLIENT_URL=http://localhost:5173

# local | firestore
STORAGE_PROVIDER=local

# Keep false locally unless Firebase Admin secrets are configured.
REQUIRE_AUTH=false

# Local storage root for screenshots/recordings/db.json
LOCAL_STORAGE_ROOT=storage

# Optional Google Drive archival for recordings.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=

# Auto-delete recordings older than this many days (local + Drive metadata).
RECORDINGS_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MINUTES=60

# Invite code expiration for camera onboarding requests.
CAMERA_INVITE_CODE_EXPIRY_MINUTES=15

# Firebase Admin (for verifying ID tokens server-side, and Firestore access)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
